{
  "productName": "SrvFiles",
  "version": "1.0.0",
  "identifier": "com.srvfiles.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/srvfiles-sidecar"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "SrvFiles",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "frame-src": "http: https:",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REEMPLAZAR_CON_LA_CLAVE_PUBLICA_DE_npx_tauri_signer_generate",
      "endpoints": [
        "https://github.com/dotdeivid/srvfiles/releases/latest/download/latest.json"
      ]
    }
  }
}
