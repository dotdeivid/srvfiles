{
  "name": "srvfiles",
  "version": "1.0.0",
  "description": "Local network file server for easy file sharing between devices",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && go run ./cmd/server",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "install:all": "npm install && cd frontend && npm install",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "concurrently": "^9.1.2"
  }
}
