# ─── Server ─────────────────────────────────────────────────────────
# Puerto en el que escucha el servidor HTTP (default: 3001)
# El servidor HTTPS arranca automáticamente en PORT+1 (ej: 3002)
PORT=3001

# Directorio donde se persiste el certificado TLS autofirmado (default: <cwd>/certs)
# En Tauri, el sidecar recibe esta variable automáticamente apuntando a app_data_dir/certs
# CERTS_DIR=/ruta/a/certs

# ─── App ────────────────────────────────────────────────────────────
# Nombre de la aplicación (usado en logs y UI)
APP_NAME=SrvFiles

# Puerto del servidor de desarrollo frontend (usado para CORS en dev)
FRONTEND_PORT=5173

# ─── Files ──────────────────────────────────────────────────────────
# Tamaño máximo de archivo para subir, en MB (default: 10240 = 10 GB)
MAX_FILE_SIZE_MB=10240

# Cantidad máxima de archivos por request de subida (default: 50)
MAX_UPLOAD_COUNT=50

# Tamaño máximo de archivo para previsualizar, en MB (default: 1024 = 1 GB)
# Archivos más grandes que este límite no podrán ser previsualizados
# desde la app web, Tauri o mobile.
PREVIEW_MAX_FILE_SIZE_MB=1024
